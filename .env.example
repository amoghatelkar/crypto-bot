# ───────────── ZebPay API ─────────────
ZEBPAY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx       # ← copy from ZebPay “API Keys”
ZEBPAY_API_SECRET=yyyyyyyyyyyyyyyyyyyyyyyyyyy # ← copy/keep safe – shown once

# ───────────── Telegram Alerts ─────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...          # BotFather token
TELEGRAM_CHAT_ID=123456789                    # Your chat-id from @userinfobot

# ───────────── Strategy Settings ───────────
# polling interval in **seconds**
INTERVAL=30

# SMA periods (in 1-minute candles)
SHORT_PERIOD=5
LONG_PERIOD=10

# RSI look-back period
# (14 is default; code uses 14 internally – change here only if you edit the bot)
# RSI_PERIOD=14   ← not read from .env right now